  \tikz[overlay,remember picture,baseline=0.3em]{\fill[fill=colorblue]  (-0.3,0.05) rectangle (0,0.9); }\libertadfont\color{colororange}~~\Large\textbf{\insertframetitle}\\\hspace{0.5em} \normalsize\underline{\insertframesubtitle}}

\usefonttheme[onlymath]{serif} %para usar fonte do LaTeX nas equações

% Fonte do template

\IfFontExistsTF{Calibri}{%
  \setmainfont[
    BoldFont={Calibri Bold},
    ItalicFont={Calibri Italic},
    BoldItalicFont={Calibri Bold Italic}
  ]{Calibri}

  \newfontfamily{\templatefont}[
    BoldFont={Calibri Bold},
    ItalicFont={Calibri Italic},
    BoldItalicFont={Calibri Bold Italic}
  ]{Calibri}

  \newfontfamily{\libertadfont}[
    BoldFont={Calibri Bold},
    ItalicFont={Calibri Italic},
    BoldItalicFont={Calibri Bold Italic}
  ]{Calibri}
}{%
  \setmainfont{TeX Gyre Heros}

  \newfontfamily{\templatefont}{TeX Gyre Heros}

  \newfontfamily{\libertadfont}{TeX Gyre Heros}
}

\setbeamerfont{frametitle}{family=\templatefont,shape=\itshape}
\setbeamerfont{framesubtitle}{family=\templatefont,shape=\itshape}
\setbeamerfont{block title}{family=\templatefont,shape=\itshape}
\setbeamerfont{section in head}{family=\templatefont,series=\bfseries}
\setbeamerfont{normal text}{size=\normalsize,family=\templatefont}
\setbeamerfont{section in toc}{size=\normalsize,family=\templatefont}
\setbeamerfont{subsection in toc}{size=\normalsize,family=\templatefont}

% Sumário

\setbeamertemplate{section in toc}{%
  \usebeamercolor[fg]{circle}%
  \makebox[1em][r]{\color{colororange}\icon}%
  \parbox[t]{\dimexpr\linewidth-1em}{\rule{0pt}{.55cm}\color{colorblue}\inserttocsection}%
}

\setbeamertemplate{subsection in toc}{%
  \usebeamercolor[fg]{item}%
  \makebox[2em][r]{\color{colororange}\subicon}%
  \parbox[t]{\dimexpr\linewidth-0.5em}{\rule{0pt}{.2cm}\scriptsize\color{colorblue}\inserttocsubsection}%
}

% Contagem dos slides
\newcounter{totalfr}
\setbeamertemplate{footline}{
  \ifnum\inserttotalframenumber=1
  \setcounter{totalfr}{2}
  \else
  \setcounter{totalfr}{\inserttotalframenumber}
  \fi
  \hfill{
    \tikz{
      \filldraw[fill=colororange!40, draw=colororange!10]  (0,0) -- (0.2,0) arc (0:{\value{framenumber}*(360/(\value{totalfr}))}:0.2) -- (0,0); 
      \node at (0,0) {\normalsize \color{colorblue}\scriptsize{\bf\insertframenumber}};
    }
  }
  \hspace{2em}
  \vspace*{1em}
}

% Definição dos itens e blocos

\newenvironment{baseitemize}
               {\itemize[leftmargin=*]}
               {\enditemize}
               
\newenvironment{fullpageitemize}
               {\itemize[nolistsep,itemsep=\fill,leftmargin=*]}
               {\vfill\enditemize}
                              
\newenvironment{orangeblock}{%
  \setbeamercolor{block body}{bg=colororange!15, fg=black}
  \setbeamercolor{block title}{bg=colororange,fg=white}
  \begin{block}}{\end{block}}

\newenvironment{blueblock}{%
  \setbeamercolor{block body}{bg=colorblue!15, fg=black}
  \setbeamercolor{block title}{bg=colorblue,fg=white}
  \begin{block}}{\end{block}}



