% Adicional para os itens poderem ser enumerados

\newcommand{\circled}[2][]{%
  \tikz[baseline=(char.base)]{%
    \node[shape = circle, draw, inner sep = 0.5pt]
    (char) {\phantom{\ifblank{#1}{#2}{#1}}};%
    \node at (char.center) {\makebox[0pt][c]{#2}};}}
\robustify{\circled}

\newcommand{\dcircled}[1]{\circled[00]{#1}}

% Slides com fundo diferente ou com imagem de fundo

\newcommand{\framecard}[2][colorblue]{
  \tikz[overlay, remember picture] {
    \fill [#1] (current page.south west) rectangle (100,100);
    \node [at=(current page.center)] {#2};
  }
  \thispagestyle{empty}
}

\newcommand{\framepic}[3][1]{
  \tikz[overlay, remember picture] {
    \node[opacity=#1, at=(current page.center)] {
      \includegraphics[width=\paperwidth]{#2};
    };
    \node [at=(current page.center)] {#3};
  }
  \thispagestyle{empty}
}

